# AidCare Web (apps/web) — public env vars (NEXT_PUBLIC_* are exposed to the browser)
#
# The frontend talks ONLY to the API (services/api). The AI Engine is internal
# and is reached server-to-server by the API — never expose its URL to the browser.
#
# Local dev (API + websocket are the same services/api server on :4000):
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WEBSOCKET_URL="http://localhost:4000"
#
# Production: set these in the Netlify dashboard (Site settings → Environment
# variables) to the deployed API's URL, e.g. https://api.theaidcare.com
# Use http(s):// — NOT ws(s):// — socket.io upgrades the http origin itself.

# Optional analytics + TTS voice IDs (multilingual playback)
# NEXT_PUBLIC_GA_ID=""
# NEXT_PUBLIC_VOICE_EN=""
# NEXT_PUBLIC_VOICE_HA=""
# NEXT_PUBLIC_VOICE_YO=""
# NEXT_PUBLIC_VOICE_IG=""
# NEXT_PUBLIC_VOICE_PCM=""
